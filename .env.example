# Leave blank to use the built-in labs only.
OPENAI_API_KEY=
# OpenAI-compatible chat completions endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Auth.js session signing secret. Use a long random string before any shared deploy.
AUTH_SECRET=replace-with-a-long-random-string

# SQLite file used by Prisma. The path is relative to the prisma/ folder.
DATABASE_URL="file:./dev.db"

# Dev credentials provider. Documented defaults work for local testing.
# Change the password before exposing the app beyond your machine.
AUTH_DEV_EMAIL=teacher@localhost
AUTH_DEV_PASSWORD=virtuallabs

# Optional GitHub OAuth. Leave blank to hide the GitHub button.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
